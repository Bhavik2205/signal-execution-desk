# Copy to .env.local and adjust as needed. Both variables are optional.

# Where the Vite dev server proxies /api and /ws.
# Defaults to http://localhost:8080, which is the Go backend's http_port.
VITE_BACKEND_ORIGIN=http://localhost:8080

# Absolute API origin for production builds served from a different host than
# the API. Leave unset in development: an empty base URL means requests go to
# /api/v1/... on the dev server, which proxies them and keeps the browser
# same-origin (so the Go server needs no CORS configuration).
# VITE_API_BASE_URL=https://api.example.com
